# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
#   cp .env.example .env

# Aforo ingest credential. Created in the Aforo admin panel (API Keys) for
# tenant "protean" with scope usage:ingest. This authenticates Kong to the
# ingestor -- it does NOT identify the customer being billed.
#
# It must be an organization-service key. A key minted through pricing-service
# (the post-purchase wizard) is not in the store the ingestor validates against,
# and every flush fails with "API key validation service unavailable" -- the
# same message a completely fake key produces.
AFORO_INGEST_KEY=sk_live_REPLACE_ME

# ICICI's key, presented by ICICI on every call. Kong verifies it locally; the
# matching consumer decides who gets billed. Never the same value as above.
ICICI_API_KEY=sk_live_REPLACE_ME

# ICICI's Aforo customerId. Becomes consumer.custom_id, which is what the plugin
# stamps on each event. A friendly name here produces events that cannot be
# attributed to a subscription.
ICICI_CUSTOMER_ID=REPLACE_ME
